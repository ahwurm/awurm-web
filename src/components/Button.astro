---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  external?: boolean;
  download?: string | boolean;
  type?: 'submit' | 'button';
  class?: string;
}
const { href, variant = 'primary', external = false, download, type = 'submit', class: className = '' } = Astro.props;

// Editorial pills: quiet sans, one vermilion primary per view.
const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-2.5 text-[0.875rem] font-medium tracking-[0.01em] transition-colors duration-150';
const styles = {
  primary: 'bg-accent-fill text-accent-ink hover:opacity-90',
  outline: 'border border-ink/35 text-ink hover:border-accent hover:text-accent',
  ghost: 'text-accent hover:bg-surface-2',
};
---

{
  href ? (
    <a
      href={href}
      class:list={[base, styles[variant], className]}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      download={download}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[base, styles[variant], className]}>
      <slot />
    </button>
  )
}
