      <line x1="46" y1="65.6" x2="546" y2="65.6" stroke="var(--color-dim)" stroke-dasharray="6 5" vector-effect="non-scaling-stroke"></line>

      <g class="fig-label" fill="var(--color-dim)">
        <text x="546" y="59" text-anchor="end">a = 1.2</text>
        <text x="46" y="299">0</text>
