      <polyline points="46.0,281.6 51.5,271.2 57.0,276.2 62.5,254.3 68.0,256.4 73.5,231.7 79.0,212.5 84.5,228.5 90.0,218.0 95.4,232.2 100.9,225.6 106.4,227.6 111.9,224.4 117.4,237.8 122.9,232.7 128.4,205.3 133.9,198.3 139.4,199.9 144.9,208.0 150.4,212.8 155.9,217.2 161.4,212.2 166.9,220.5 172.4,212.4 177.9,203.6 183.3,206.9 188.8,214.3 194.3,208.5 199.8,192.6 205.3,210.8 210.8,223.3 216.3,219.7 221.8,231.7 227.3,231.2 232.8,245.5 238.3,247.4 243.8,269.4 249.3,269.4 254.8,266.1 260.3,281.8 265.8,291.6 271.3,269.3 276.7,255.9 282.2,254.8 287.7,254.7 293.2,249.9 298.7,239.5 304.2,220.5 309.7,194.1 315.2,192.7 320.7,199.6 326.2,193.2 331.7,167.6 337.2,193.6 342.7,187.8 348.2,188.4 353.7,189.3 359.2,198.5 364.7,171.6 370.1,165.8 375.6,158.8 381.1,169.1 386.6,165.3 392.1,154.8 397.6,138.7 403.1,112.7 408.6,119.1 414.1,103.6 419.6,99.0 425.1,93.4 430.6,86.7 436.1,84.9 441.6,88.5 447.1,79.7 452.6,63.5" stroke="var(--color-accent)" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
      <!-- commit tick at first passage -->
      <line x1="451.8" y1="58.6" x2="451.8" y2="72.6" stroke="var(--color-accent)" stroke-width="2" vector-effect="non-scaling-stroke"></line>
      <circle cx="451.8" cy="65.6" r="3" fill="var(--color-accent)"></circle>
      <text class="fig-mu" x="392" y="128" text-anchor="end" fill="var(--color-accent)">μ</text>
    </svg>
    <canvas id="hero-canvas" class="absolute inset-0 h-full w-full" hidden></canvas>
    <button id="hero-rerun" type="button" class="absolute inset-0 cursor-pointer" aria-label="Re-run trial" hidden></button>
  </div>
  <figcaption class="meta lowercase mt-3 text-dim">
    fig. 1 — evidence accumulation to boundary; first passage determines response.
  </figcaption>
</figure>

<style>
  /* registration marks: a plate on the measurement paper, not a card */
  .plate {
    position: relative;
    padding: 14px;
  }
  .plate > i {
    position: absolute;
    width: 11px;
    height: 11px;
    border: 0 solid var(--color-dim);
    opacity: 0.65;
  }
  .plate > i:nth-of-type(1) { top: 0; left: 0; border-top-width: 1.5px; border-left-width: 1.5px; }
  .plate > i:nth-of-type(2) { top: 0; right: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
  .plate > i:nth-of-type(3) { bottom: 0; left: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .plate > i:nth-of-type(4) { bottom: 0; right: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }

  .fig-label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .fig-mu {
    font-family: var(--font-mono);
    font-size: 14px;
    font-style: italic;
    font-weight: 500;
  }
</style>

<script>
  import { createRace } from '../lib/accumulator';

  const svg = document.getElementById('hero-svg')!;
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const rerun = document.getElementById('hero-rerun') as HTMLButtonElement;
  const copy = document.getElementById('hero-copy');
  const vis = document.getElementById('hero-readout-vis');
  const sr = document.getElementById('hero-readout-sr');

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced || !copy || !vis || !sr || !canvas.getContext('2d')) {
    // static figure stands; make sure copy is never left hidden
    copy?.classList.remove('stamp-wait');
  } else {
    let trials = 0;
    let typer: ReturnType<typeof setInterval>;

    const type = (text: string) => {
      clearInterval(typer);
      sr.textContent = text; // screen readers get the full line at once
      vis.textContent = '';
      let i = 0;
      typer = setInterval(() => {
        vis.textContent = text.slice(0, ++i);
        if (i >= text.length) clearInterval(typer);
      }, 14);
    };

    const race = createRace(canvas, {
      onCommit: (_winner, rt) => {
        trials++;
        copy.classList.remove('stamp-wait');
        copy.classList.add('stamp-go');
        rerun.hidden = false;
        setTimeout(
          () => type(`decision: alexander_h_wurm · rt = ${rt} ms · trials = ${trials}`),
          trials === 1 ? 350 : 0
        );
      },
    });

    // arm the live instrument (index.astro pre-hid the copy via .stamp-wait)
    sr.textContent = '';
    vis.textContent = '';
    svg.setAttribute('hidden', '');
    canvas.hidden = false;
    race.start();

    // failsafe: never leave the hero copy hidden
    setTimeout(() => {
      if (copy.classList.contains('stamp-wait')) {
        copy.classList.remove('stamp-wait');
        copy.classList.add('stamp-go');
      }
    }, 6000);

    rerun.addEventListener('click', () => {
      if (race.running()) return; // one trial at a time
      vis.textContent = '';
      race.start();
    });

    // repaint the completed figure when the theme flips
    new MutationObserver(() => race.redraw()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
