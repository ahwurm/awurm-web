        <text x="379.3" y="299" text-anchor="middle">400</text>
        <text x="546" y="299" text-anchor="end">600</text>
        <text x="296" y="316" text-anchor="middle">time (ms)</text>
        <text x="17" y="153.8" text-anchor="middle" transform="rotate(-90 17 153.8)">evidence</text>
      </g>

