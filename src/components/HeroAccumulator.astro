---
/**
 * The hero methods figure: a drift-diffusion race drawn as fig. 1 on the
 * measurement grid. Default render is a completed static trial (inline SVG,
 * generated by scripts/hero-fig.mjs) — this is what no-JS and
 * prefers-reduced-motion users get. With JS + motion allowed, the script
 * hides the SVG and runs the live canvas race (src/lib/accumulator.ts),
 * then stamps in the hero copy (#hero-copy) and types the readout
 * (#hero-readout-sr / #hero-readout-vis) with the real first-passage time.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const svgAlt =
  'Completed drift-diffusion trial: four evidence traces accumulate over time; the winning trace crosses the decision boundary a = 1.2 at 487 ms.';
---

<figure class:list={['plate', className]}>
  <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
  <div class="relative" style="aspect-ratio: 560 / 350;">
    <svg
      id="hero-svg"
      viewBox="0 0 560 350"
      class="block h-full w-full"
      role="img"
      aria-label={svgAlt}
      fill="none"
    >
      <!-- axes -->
      <path d="M 46 26 V 281.6 H 546" stroke="var(--color-dim)" stroke-opacity="0.75" vector-effect="non-scaling-stroke"></path>
      <!-- x ticks: 0 / 200 / 400 / 600 ms -->
      <path
        d="M 46 281.6 v 5 M 212.7 281.6 v 5 M 379.3 281.6 v 5 M 546 281.6 v 5"
