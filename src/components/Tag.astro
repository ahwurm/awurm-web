---
// Research type as a threshold marker: colored tick + mono label (no pill).
// Maps a Nucleus research `type` string to a muted hue token.
interface Props {
  type: string;
  class?: string;
}
const { type, class: className = '' } = Astro.props;

const toneVar: Record<string, string> = {
  'ROI Study': '--color-tag-roi',
  'ROI Guidebook': '--color-tag-guide',
  Surveys: '--color-tag-survey',
  Announcement: '--color-tag-announce',
  // 'Research Note' and anything else falls back to --color-dim via .threshold default
};
const tone = toneVar[type];
---

<span
  class:list={['threshold meta lowercase whitespace-nowrap', className]}
  style={tone ? `--tag: var(${tone})` : undefined}
>
  {type}
</span>
