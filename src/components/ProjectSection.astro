---
// One project as a bordered card, matching the research and speaking lists:
// accent name, one-line description, links, and a small 3:2 visual in the
// terminal-window Frame. Text-left / visual-right on desktop; text-first when
// stacked on mobile.
// No index numbers and no descriptor pills — the pills read as filter affordances
// but never filtered anything, so they were removed (owner 2026-09-08: "the tags
// there suck right now, just kill them").
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Frame from './Frame.astro';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

type Visual =
  | { kind: 'video'; webm: string; mp4: string; poster: string; alt: string }
  | { kind: 'image'; src: ImageMetadata; fit: 'cover' | 'contain'; matte?: string; alt: string };

interface Props {
  slug: string;
  name: string;
  description: string;
  links: { label: string; href: string; download?: string; icon?: string; mark?: string; iconOnly?: boolean }[];
  titleHref?: string; // the project's primary link — makes the green title clickable
  brand?: 'fantasytoolbench' | 'localharness'; // render the product's own lockup instead of plain text
  visual: Visual;
}
const { slug, name, description, links, titleHref, brand, visual } = Astro.props;
---

<article
  id={`p-${slug}`}
  data-project
  data-label={name}
  class="grid items-center gap-x-12 gap-y-6 rounded-[3px] border border-edge bg-surface p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_28rem]"
>
  <div>
    <div>
      <h2 class="font-display text-[clamp(1.5rem,3.5vw,2rem)] font-semibold leading-tight tracking-tight text-accent">
        {
          titleHref ? (
            <a href={titleHref} target="_blank" rel="noopener noreferrer" class="transition-colors duration-150 hover:underline">
              <Brand name={name} brand={brand} />
            </a>
          ) : (
            <Brand name={name} brand={brand} />
          )
        }
      </h2>
    </div>
    <p class="mt-3 max-w-[48ch] text-[0.95rem] leading-relaxed text-dim">{description}</p>
    <p class="mt-5 flex flex-wrap items-center gap-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            download={l.download}
            target={l.download ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={l.iconOnly ? l.label : undefined}
            title={l.iconOnly ? l.label : undefined}
            class:list={[
              'inline-flex items-center justify-center gap-2 rounded-[4px] border border-edge font-mono text-[0.8rem] font-medium lowercase tracking-[0.02em] text-ink transition-colors duration-150 hover:border-accent hover:text-accent',
              l.iconOnly ? 'px-2.5 py-2' : 'px-3.5 py-2',
            ]}
          >
            {l.mark && <BrandIcon name={l.mark} class="h-4 w-4" />}
            {l.icon && <Icon name={l.icon} class="h-3.5 w-3.5" />}
            {!l.iconOnly && l.label}
          </a>
        ))
      }
    </p>
  </div>

  <div class="w-full lg:justify-self-end">
    <Frame>
      {
        visual.kind === 'video' ? (
          <Fragment>
            <video
              class="rm-motion aspect-[3/2] w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              poster={visual.poster}
              aria-label={visual.alt}
            >
              <source src={visual.webm} type="video/webm" />
              <source src={visual.mp4} type="video/mp4" />
            </video>
            <img class="rm-still aspect-[3/2] w-full object-cover" src={visual.poster} alt={visual.alt} />
          </Fragment>
        ) : visual.fit === 'contain' ? (
          <div class="grid aspect-[3/2] place-items-center" style={`background:${visual.matte}`}>
            <Image src={visual.src} alt={visual.alt} class="max-h-full w-full object-contain" loading="lazy" />
          </div>
        ) : (
          <Image src={visual.src} alt={visual.alt} class="aspect-[3/2] w-full object-cover" loading="lazy" />
        )
      }
    </Frame>
  </div>
</article>
