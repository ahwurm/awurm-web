---
/**
 * Interactive terminal. Server-renders a completed session (SEO / no-JS /
 * reduced-motion all see this) and attaches a real prompt: ls, cd (with
 * real directories incl. research/academic + research/industry), pwd,
 * whoami, resume, contact, theme, clear, help — plus an easter egg or two.
 * `intro="notfound"` renders the 404 failed-cd session instead of whoami.
 * No email address ever appears — contact routes to the form.
 */
import { profile } from '../data/profile';

interface Props {
  intro?: 'whoami' | 'notfound';
  class?: string;
}
const { intro = 'whoami', class: className } = Astro.props;

const whoamiOut = [`${profile.name} — AI · data · decision science`, 'Curiosity-led builder and researcher.'];
const lsEntries = [
  ['projects/', '/projects/'],
  ['research/', '/research/'],
  ['speaking/', '/speaking/'],
  ['contact/', '/contact/'],
  ['resume.pdf', '/AW_Resume2025_web.pdf'],
] as const;
---

<div class:list={['term', className]} data-term>
  <div class="term-bar">
    <span aria-hidden="true" class="flex gap-1.5">
      <i class="h-2.5 w-2.5 rounded-full border border-edge"></i>
      <i class="h-2.5 w-2.5 rounded-full border border-edge"></i>
      <i class:list={['h-2.5 w-2.5 rounded-full', intro === 'notfound' ? 'bg-error/70' : 'bg-accent/70']}></i>
    </span>
    <span class="ml-2">alex@awurm:~</span>
    <span class="ml-auto hidden sm:inline">bash — 80×24</span>
  </div>
  <div class="term-body" data-term-body aria-live="polite">
    <div data-term-static>
      {
        intro === 'notfound' ? (
          <>
            <p>
              <span class="t-prompt">$</span> <span class="t-cmd" data-nf-path>cd …</span>
            </p>
            <p class="t-out">
              <span class="text-error">bash: cd:</span> no such file or directory
            </p>
            <p class="mt-3">
              <span class="t-prompt">$</span> <span class="t-cmd">echo $?</span>
            </p>
            <p class="t-out">
              <span class="t-num">404</span>
            </p>
            <p class="t-out mt-3">
              try <a href="/">cd ~</a> or type <span class="t-hi">help</span>
              <span class="t-cursor" aria-hidden="true" />
            </p>
          </>
        ) : (
          <>
            <p>
              <span class="t-prompt">$</span> <span class="t-cmd">whoami</span>
            </p>
            {whoamiOut.map((l) => (
              <p class="t-out">{l}</p>
            ))}
            <p class="mt-3">
              <span class="t-prompt">$</span> <span class="t-cmd">ls</span>
            </p>
            <p class="t-out flex flex-wrap gap-x-5 gap-y-1">
              {lsEntries.map(([label, href]) => (
                <a href={href}>{label}</a>
              ))}
            </p>
            <p class="t-out mt-3">
              type <span class="t-hi">help</span> to look around <span class="t-cursor" aria-hidden="true" />
            </p>
          </>
        )
      }
    </div>
    <form data-term-form class="mt-1 hidden items-baseline gap-2" autocomplete="off">
      <span class="t-prompt shrink-0" aria-hidden="true">$</span>
      <input
        data-term-input
        class="term-input"
        type="text"
        spellcheck="false"
        autocapitalize="off"
        aria-label="Terminal command input"
      />
    </form>
  </div>
</div>

<script>
  for (const term of document.querySelectorAll<HTMLElement>('[data-term]')) {
    const body = term.querySelector<HTMLElement>('[data-term-body]')!;
    const staticBlock = term.querySelector<HTMLElement>('[data-term-static]')!;
    const form = term.querySelector<HTMLFormElement>('[data-term-form]')!;
    const input = term.querySelector<HTMLInputElement>('[data-term-input]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Real site filesystem. Leaves map to URLs; dirs may have children.
    const FS: Record<string, { url: string; children?: Record<string, string> }> = {
      projects: { url: '/projects/' },
      research: {
        url: '/research/',
        children: { academic: '/research/', industry: '/research/?tab=industry' },
      },
      speaking: { url: '/speaking/' },
      talks: { url: '/speaking/' },
      contact: { url: '/contact/' },
      about: { url: '/contact/' },
    };

    const el = (html: string) => {
      const d = document.createElement('div');
      d.innerHTML = html;
      return d;
    };
    const print = (html: string) => {
      form.before(el(html));
      body.scrollTop = body.scrollHeight;
    };
    const printText = (text: string) => {
      const p = el('<p class="t-out"></p>');
      p.firstElementChild!.textContent = text;
      form.before(p);
      body.scrollTop = body.scrollHeight;
    };
    const nav = (url: string) => {
      print(`<p class="t-out">→ ${url}</p>`);
      setTimeout(() => location.assign(url), reduced ? 0 : 250);
    };
    const resolve = (raw: string): string | null => {
      const parts = raw.replace(/^~?\/+|\/+$/g, '').toLowerCase().split('/').filter(Boolean);
      if (parts.length === 0) return '/';
      const root = FS[parts[0]];
      if (root) {
        if (parts.length === 1) return root.url;
        const child = root.children?.[parts[1]];
        return parts.length === 2 && child ? child : null;
      }
      // bare subdirectory (cd academic / cd industry) resolves if unique
      if (parts.length === 1) {
        for (const d of Object.values(FS)) if (d.children?.[parts[0]]) return d.children[parts[0]];
      }
      return null;
    };

    const LS_TOP =
      '<p class="t-out flex flex-wrap gap-x-5 gap-y-1">' +
      [
        ['projects/', '/projects/'],
        ['research/', '/research/'],
        ['speaking/', '/speaking/'],
        ['contact/', '/contact/'],
        ['resume.pdf', '/AW_Resume2025_web.pdf'],
      ]
        .map(([l, h]) => `<a href="${h}">${l}</a>`)
        .join(' ') +
      '</p>';
    const LS_RESEARCH =
      '<p class="t-out flex flex-wrap gap-x-5 gap-y-1"><a href="/research/">academic/</a> <a href="/research/?tab=industry">industry/</a></p>';

    const HELP: [string, string][] = [
      ['ls [dir]', 'list pages (try ls research)'],
      ['cd <dir>', 'go there — projects, research/industry, speaking, contact'],
      ['whoami', 'who is this guy'],
      ['resume', 'open the resume pdf'],
      ['contact', 'go to the contact form'],
      ['theme', 'toggle dark/light'],
      ['clear', 'clean up'],
    ];

    function run(raw: string) {
      const line = raw.trim();
      const lineEl = el('<p class="mt-3"><span class="t-prompt">$</span> <span class="t-cmd"></span></p>');
      lineEl.querySelector('.t-cmd')!.textContent = line; // textContent: never inject input as HTML
      form.before(lineEl);
      if (!line) return;
      const [cmd, ...args] = line.toLowerCase().split(/\s+/);
      const arg = args[0] ?? '';

      if (cmd === 'help' || cmd === '?') {
        print(
          '<div class="t-out">' + HELP.map(([c, d]) => `<p><span class="t-hi">${c}</span> — ${d}</p>`).join('') + '</div>'
        );
      } else if (cmd === 'ls' || cmd === 'dir') {
        const a = arg.replace(/\/$/, '');
        if (!a) print(LS_TOP);
        else if (a === 'research' || a === '~/research') print(LS_RESEARCH);
        else if (resolve(a)) print('<p class="t-out">(empty — it is a page, cd into it)</p>');
        else printText(`ls: cannot access '${arg}': no such directory`);
      } else if (cmd === 'whoami') {
        print(
          `<p class="t-out">Alexander H. Wurm — <span class="t-hi">AI · data · decision science</span></p>` +
            `<p class="t-out">Curiosity-led builder and researcher.</p>`
        );
      } else if (cmd === 'cd') {
        if (!arg) return nav('/');
        const target = resolve(arg);
        if (target === '/') nav('/');
        else if (target) nav(target);
        else printText(`cd: no such directory: ${arg}`);
      } else if (FS[cmd]) {
        nav(FS[cmd].url);
      } else if (cmd === 'resume' || line.toLowerCase() === 'cat resume.pdf' || cmd === 'open') {
        nav('/AW_Resume2025_web.pdf');
      } else if (cmd === 'email' || cmd === 'mail') {
        print('<p class="t-out">no address here — use the form: <a href="/contact/">/contact/</a></p>');
      } else if (cmd === 'theme') {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        print(`<p class="t-out">theme → ${next}</p>`);
      } else if (cmd === 'clear' || cmd === 'cls') {
        Array.from(body.children).forEach((n) => !n.hasAttribute('data-term-form') && n.remove());
      } else if (cmd === 'sudo') {
        if (line.includes('hire'))
          print('<p class="t-out"><span class="t-hi">Permission granted.</span> → <a href="/contact/">/contact/</a></p>');
        else printText('alex is not in the sudoers file. This incident will be reported.');
      } else if (cmd === 'pwd') {
        printText(location.pathname === '/' ? '/home/alex/awurm.com' : `/home/alex/awurm.com${location.pathname}`);
      } else if (cmd === 'exit') {
        print('<p class="t-out">there is no escape. try <span class="t-hi">ls</span></p>');
      } else {
        const p = el(`<p class="t-out"><span data-echo></span> — try <span class="t-hi">help</span></p>`);
        p.querySelector('[data-echo]')!.textContent = `command not found: ${cmd}`;
        form.before(p);
      }
    }

    const hist: string[] = [];
    let hi = 0;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input.value;
      if (v.trim()) {
        hist.push(v);
        hi = hist.length;
      }
      input.value = '';
      run(v);
      body.scrollTop = body.scrollHeight;
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        if (hi > 0) input.value = hist[--hi] ?? '';
        e.preventDefault();
      } else if (e.key === 'ArrowDown') {
        input.value = hist[++hi] ?? '';
        if (hi > hist.length) hi = hist.length;
        e.preventDefault();
      }
    });

    // 404 intro: echo the real failed path (textContent — never HTML).
    const nf = term.querySelector('[data-nf-path]');
    if (nf) nf.textContent = `cd ${location.pathname}`;

    // Enable the live prompt; drop the static cursor line.
    form.classList.remove('hidden');
    form.classList.add('flex');
    staticBlock.querySelector('.t-cursor')?.parentElement?.remove();

    term.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      input.focus({ preventScroll: true });
    });
  }
</script>
