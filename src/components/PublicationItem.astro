---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  publication: CollectionEntry<'publications'>;
}
const { publication } = Astro.props;
const { title, authors, venue, year, kind, url, pdfUrl } = publication.data;
const { Content } = await render(publication);
---

<article class="rounded-[3px] border border-edge bg-surface p-6">
  <div class="flex items-baseline justify-between gap-3">
    <span class="meta lowercase text-dim">[{kind === 'preprint' ? 'preprint' : 'peer-reviewed'}]</span>
    <span class="meta text-dim">{year}</span>
  </div>
  <h3 class="mt-3 text-xl font-semibold leading-snug tracking-tight">
    <a href={url} target="_blank" rel="noopener noreferrer" class="transition-colors duration-150 hover:text-accent">
      {title}
    </a>
  </h3>
  <p class="mt-2 text-sm text-dim">{authors}</p>
  <p class="meta lowercase mt-2 text-dim">{venue}</p>

  <details class="group mt-4">
    <summary class="meta lowercase cursor-pointer text-accent hover:underline">abstract</summary>
    <div class="mt-2 text-sm leading-relaxed text-dim">
      <Content />
    </div>
  </details>

  <div class="mt-5 flex flex-wrap gap-3">
    <Button href={url} external>Read {kind === 'preprint' ? 'preprint' : 'paper'} ↗</Button>
    {
      pdfUrl && (
        <Button href={pdfUrl} variant="outline" download="wurm-2021-timing-anticipatory-decisions.pdf">
          Download PDF
        </Button>
      )
    }
  </div>
</article>
