---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Frame from './Frame.astro';
import Icon from './Icon.astro';

interface Props {
  publication: CollectionEntry<'publications'>;
  figure?: { src: ImageMetadata; label: string; alt: string };
}
const { publication, figure } = Astro.props;
const { title, authors, venue, year, kind, label, url, pdfUrl } = publication.data;
const { Content } = await render(publication);
---

<article class="border-b border-edge py-8 first:border-t">
  <div
    class:list={['grid items-start gap-x-10 gap-y-5', figure && 'lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]']}
  >
    <div>
      <div class="flex items-baseline justify-between gap-3">
        <span class="kicker text-dim">{label ?? (kind === 'preprint' ? 'Preprint' : 'Peer-reviewed')}</span>
        <span class="meta text-dim">{year}</span>
      </div>
      <h3 class="font-display mt-3.5 max-w-3xl text-[1.45rem] font-semibold leading-[1.2] tracking-tight">
        <a href={url} target="_blank" rel="noopener noreferrer" class="text-accent transition-colors duration-150 hover:underline">
          {title}
        </a>
      </h3>
      <p class="mt-2.5 text-sm text-dim">{authors}</p>
      <p class="mt-1.5 text-sm italic text-dim">{venue}</p>

      <details class="group mt-4">
        <summary class="link-rule cursor-pointer text-[0.875rem] font-medium">Abstract</summary>
        <div class="mt-3 max-w-3xl text-[0.9375rem] leading-relaxed text-dim">
          <Content />
        </div>
      </details>

      <p class="mt-5 flex flex-wrap gap-5">
        <a href={url} target="_blank" rel="noopener noreferrer" class="link-rule text-[0.875rem] font-medium">
          Read {kind === 'preprint' ? 'preprint' : 'paper'} ↗
        </a>
        {
          pdfUrl && (
            <a
              href={pdfUrl}
              download="wurm-2021-timing-anticipatory-decisions.pdf"
              class="link-rule inline-flex items-center gap-1.5 text-[0.875rem] font-medium"
            >
              <Icon name="download" class="h-3.5 w-3.5" />
              Download PDF
            </a>
          )
        }
      </p>
    </div>
    {
      figure && (
        <Frame label={figure.label}>
          <Image src={figure.src} alt={figure.alt} width={680} class="w-full bg-white" />
        </Frame>
      )
    }
  </div>
</article>
