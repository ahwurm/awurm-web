---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-edge bg-bg/90 backdrop-blur">
  <nav class="container-site flex h-16 items-center justify-between gap-3" aria-label="Main">
    <a
      href="/"
      class="font-display text-[1.05rem] font-semibold tracking-tight text-ink transition-colors duration-150 hover:text-accent"
    >
      <span class="sm:hidden" aria-label={site.name}>A.W<span class="text-accent">.</span></span>
      <span class="hidden sm:inline">{site.name}<span class="text-accent">.</span></span>
    </a>
    <div
      class="flex items-center gap-3 font-sans text-[10px] font-semibold uppercase tracking-[0.06em] sm:gap-7 sm:text-[0.72rem] sm:tracking-[0.14em]"
    >
      {
        site.nav.map(({ label, href }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'transition-colors duration-150',
              isActive(href) ? 'text-accent' : 'text-dim hover:text-ink',
            ]}
          >
            {label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>
