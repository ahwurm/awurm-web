---
import { site } from '../data/site';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-edge bg-bg/90 backdrop-blur">
  <nav class="container-site flex h-14 items-center justify-between gap-3" aria-label="Main">
    <a
      href="/"
      class="flex items-center transition-opacity duration-150 hover:opacity-80"
      aria-label="Alexander H. Wurm — home"
    >
      <img src="/favicon.svg" alt="" width="30" height="30" />
    </a>
    <div class="flex items-center gap-3 font-mono text-[11px] tracking-[0.01em] sm:gap-6 sm:text-[0.75rem]">
      {
        site.nav.map(({ label, href, icon }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 lowercase transition-colors duration-150',
              isActive(href) ? 'text-accent' : 'text-dim hover:text-ink',
            ]}
          >
            <Icon name={icon} class="hidden h-3 w-3 sm:block" />
            {label.toLowerCase()}
          </a>
        ))
      }
      <button
        id="cmdk-open"
        type="button"
        aria-label="Open command palette"
        class="meta hidden items-center gap-1 rounded border border-edge px-2 py-1 text-dim transition-colors hover:border-accent hover:text-ink sm:flex"
      >
        ⌘K
      </button>
      <ThemeToggle />
    </div>
  </nav>
</header>
