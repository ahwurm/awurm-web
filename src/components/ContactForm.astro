---
import Button from './Button.astro';
import { site } from '../data/site';
import { profile } from '../data/profile';

const { serviceId, templateId, publicKey } = site.emailjs;
const emailjsReady = Boolean(serviceId && templateId && publicKey);
---

<form
  id="contact-form"
  novalidate
  data-service={serviceId}
  data-template={templateId}
  data-key={publicKey}
  data-linkedin={profile.socials.linkedin}
  class="space-y-5"
>
  <div>
    <label for="cf-name" class="kicker mb-2 block text-dim">Name</label>
    <input
      type="text"
      id="cf-name"
      name="name"
      required
      autocomplete="name"
      aria-describedby="cf-name-error"
      class="w-full rounded-[2px] border border-edge bg-surface px-4 py-2.5 text-sm transition-colors focus:border-accent"
    />
    <p id="cf-name-error" class="mt-1.5 hidden text-sm text-error" data-error></p>
  </div>
  <div>
    <label for="cf-email" class="kicker mb-2 block text-dim">Email</label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
      aria-describedby="cf-email-error"
      class="w-full rounded-[2px] border border-edge bg-surface px-4 py-2.5 text-sm transition-colors focus:border-accent"
    />
    <p id="cf-email-error" class="mt-1.5 hidden text-sm text-error" data-error></p>
  </div>
  <div>
    <label for="cf-subject" class="kicker mb-2 block text-dim">Subject</label>
    <input
      type="text"
      id="cf-subject"
      name="subject"
      required
      aria-describedby="cf-subject-error"
      class="w-full rounded-[2px] border border-edge bg-surface px-4 py-2.5 text-sm transition-colors focus:border-accent"
    />
    <p id="cf-subject-error" class="mt-1.5 hidden text-sm text-error" data-error></p>
  </div>
  <div>
    <label for="cf-message" class="kicker mb-2 block text-dim">Message</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      aria-describedby="cf-message-error"
      class="w-full resize-y rounded-lg border border-edge bg-surface px-4 py-2.5 text-sm transition-colors focus:border-accent"
    ></textarea>
    <p id="cf-message-error" class="mt-1.5 hidden text-sm text-error" data-error></p>
  </div>

  <p id="cf-status" role="status" aria-live="polite" class="hidden text-sm font-medium"></p>

  <Button type="submit">Send message</Button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  const fieldError = (name: string, value: string): string => {
    if (!value.trim()) return `${name.charAt(0).toUpperCase() + name.slice(1)} is required`;
    if (name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) return 'Please enter a valid email address';
    if (name === 'message' && value.trim().length < 10) return 'Message must be at least 10 characters long';
    return '';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    let invalid = false;
    for (const name of ['name', 'email', 'subject', 'message']) {
      const err = fieldError(name, data[name] ?? '');
      const el = document.getElementById(`cf-${name}-error`)!;
      el.textContent = err;
      el.classList.toggle('hidden', !err);
      (document.getElementById(`cf-${name}`) as HTMLElement).setAttribute('aria-invalid', String(Boolean(err)));
      if (err && !invalid) {
        invalid = true;
        (document.getElementById(`cf-${name}`) as HTMLElement).focus();
      }
    }
    if (invalid) return;

    const { service, template, key, linkedin } = form.dataset;
    const status = document.getElementById('cf-status')!;
    const fallback = () => {
      status.classList.remove('hidden');
      status.innerHTML = '';
      status.append('The form is not wired up yet — reach me on ');
      const a = document.createElement('a');
      a.href = linkedin!;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = 'text-accent underline';
      a.textContent = 'LinkedIn';
      status.append(a, ' instead.');
    };

    if (!service || !template || !key) return fallback();

    status.classList.remove('hidden');
    status.textContent = 'Sending…';
    try {
      const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id: service,
          template_id: template,
          user_id: key,
          template_params: {
            from_name: data.name,
            from_email: data.email,
            subject: data.subject,
            message: data.message,
          },
        }),
      });
      if (!res.ok) throw new Error(`EmailJS ${res.status}`);
      status.textContent = "Message sent! Thank you for reaching out — I'll get back to you soon.";
      form.reset();
    } catch {
      fallback();
    }
  });
</script>
