---
import Tag from './Tag.astro';
import { getNucleusResearchUrl } from '../lib/research-utils';
import type { IndustryResearch } from '../lib/types';

interface Props {
  entry: IndustryResearch;
}
const { entry } = Astro.props;
const url = getNucleusResearchUrl(entry);
// NOTE: entry.pdfUrl points at never-published /references PDFs — kept in data, never rendered.
---

<article
  class="rounded-xl border border-edge bg-surface p-5"
  data-year={entry.year}
  data-type={entry.type}
>
  <div class="flex items-start justify-between gap-3">
    <Tag type={entry.type} />
    <span class="font-mono text-xs text-dim">{entry.year}</span>
  </div>
  <h3 class="mt-2.5 text-lg font-semibold leading-snug tracking-tight">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors duration-150 hover:text-accent"
    >
      {entry.title}
    </a>
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-dim">{entry.summary}</p>
  {
    entry.roiClaim && (
      <p class="tag mt-3 inline-block rounded-md px-2.5 py-1 text-sm font-medium" style="--tag: var(--color-tag-roi)">
        {entry.roiClaim}
      </p>
    )
  }
  <p class="mt-3 text-sm">
    <a href={url} target="_blank" rel="noopener noreferrer" class="font-medium text-accent hover:underline">
      Read research ↗
    </a>
  </p>
</article>
