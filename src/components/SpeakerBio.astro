---
import Card from './Card.astro';
import { profile } from '../data/profile';
---

<Card class="border-l-2 border-l-accent-fill">
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-xl font-semibold tracking-tight">Speaker bio</h2>
    <button
      id="copy-bio"
      type="button"
      data-bio={profile.speakerBio}
      class="rounded-lg border border-edge px-3 py-1.5 font-mono text-xs text-dim transition-colors duration-150 hover:border-accent hover:text-ink"
    >
      Copy
    </button>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-dim">{profile.speakerBio}</p>
</Card>

<script>
  const btn = document.getElementById('copy-bio') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.bio ?? '');
      btn.textContent = 'Copied ✓';
    } catch {
      btn.textContent = 'Copy failed';
    }
    setTimeout(() => (btn.textContent = 'Copy'), 2000);
  });
</script>
