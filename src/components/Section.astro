---
/**
 * Page section that "accumulates in": a 2px baseline rule draws across,
 * the title rises out of it, and the body reveals below it (see global.css
 * .acc-* rules; the IntersectionObserver lives in Base.astro). Without JS
 * or with reduced motion everything renders instantly.
 */
interface Props {
  title?: string;
  sub?: string;
  banded?: boolean;
  id?: string;
  class?: string;
}
const { title, sub, banded = false, id, class: className = '' } = Astro.props;
---

<section id={id} class:list={[banded && 'border-y border-edge bg-surface-2/60', className]}>
  <div class="container-site py-16 sm:py-20" data-acc>
    {title && <h2 class="acc-title text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>}
    {title && <div class="acc-rule mt-4" aria-hidden="true"></div>}
    <div class="acc-body">
      {sub && <p class="mt-4 max-w-2xl text-dim">{sub}</p>}
      <slot />
    </div>
  </div>
</section>
