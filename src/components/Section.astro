---
interface Props {
  title?: string;
  sub?: string;
  banded?: boolean;
  id?: string;
  class?: string;
}
const { title, sub, banded = false, id, class: className = '' } = Astro.props;
---

<section id={id} class:list={[banded && 'border-y border-edge bg-surface-2/50', className]}>
  <div class="container-site py-16 sm:py-20">
    {title && <h2 class="text-3xl font-semibold tracking-tight">{title}</h2>}
    {sub && <p class="mt-3 max-w-2xl text-dim">{sub}</p>}
    <slot />
  </div>
</section>
