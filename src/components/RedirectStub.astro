---
// Meta-refresh stub for old-site URLs. noindex + canonical → target; excluded from the sitemap (astro.config.mjs).
interface Props {
  to: string; // may include a #fragment
  label: string;
}
const { to, label } = Astro.props;
const canonical = new URL(to.split('#')[0], Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to {label}</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem">
    <p>This page has moved to <a href={to}>{label}</a>.</p>
  </body>
</html>
