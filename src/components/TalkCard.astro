---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { isoDate, monthYearShort } from '../lib/dates';

interface Props {
  talk: CollectionEntry<'talks'>;
  variant?: 'featured' | 'row';
  plate?: number; // accepted for compatibility; no longer rendered
}
const { talk, variant = 'row' } = Astro.props;
const { title, event, format, date, description, image, links } = talk.data;

const actions = [
  links.video && { href: links.video, label: 'Watch recording ↗', external: true },
  links.event && { href: links.event, label: 'Event page ↗', external: true },
  links.slides && { href: links.slides, label: 'Download slides', external: false },
].filter(Boolean) as { href: string; label: string; external: boolean }[];

const caption = `${event} · ${monthYearShort(date)}`;
---

{
  variant === 'featured' ? (
    <article class="flex flex-col">
      {image && (
        <Image
          src={image}
          alt={`Title slide: ${title}`}
          width={760}
          class="aspect-[16/9] w-full rounded-[2px] border border-edge object-cover"
        />
      )}
      <p class="kicker mt-5 text-dim">{caption}</p>
      <h3 class="font-display mt-2.5 text-[1.35rem] font-semibold leading-[1.2] tracking-tight">{title}</h3>
      <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-dim">{description}</p>
      {actions.length > 0 && (
        <p class="mt-auto flex flex-wrap gap-5 pt-5">
          {actions.map((a) => (
            <a
              href={a.href}
              target={a.external ? '_blank' : undefined}
              rel={a.external ? 'noopener noreferrer' : undefined}
              class="link-rule text-[0.875rem] font-medium"
            >
              {a.label}
            </a>
          ))}
        </p>
      )}
    </article>
  ) : (
    <article class="border-b border-edge py-7">
      <div class="grid items-start gap-x-8 gap-y-3 sm:grid-cols-[7.5rem_minmax(0,1fr)] lg:grid-cols-[7.5rem_minmax(0,1fr)_11rem]">
        <div class="meta flex gap-x-4 text-dim sm:flex-col sm:gap-y-1.5">
          <span>{isoDate(date)}</span>
          <span class="uppercase">{format}</span>
        </div>
        <div>
          <p class="kicker text-dim">{event}</p>
          <h3 class="font-display mt-2 text-[1.3rem] font-semibold leading-[1.2] tracking-tight">{title}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-dim">{description}</p>
          {actions.length > 0 && (
            <p class="mt-3.5 flex flex-wrap gap-5">
              {actions.map((a) => (
                <a
                  href={a.href}
                  target={a.external ? '_blank' : undefined}
                  rel={a.external ? 'noopener noreferrer' : undefined}
                  class="link-rule text-[0.875rem] font-medium"
                >
                  {a.label}
                </a>
              ))}
            </p>
          )}
        </div>
        {image && (
          <Image
            src={image}
            alt={`Title slide: ${title}`}
            width={400}
            class="hidden w-full rounded-[2px] border border-edge object-cover lg:block"
          />
        )}
      </div>
    </article>
  )
}
