---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { isoDate, monthYearShort } from '../lib/dates';

interface Props {
  talk: CollectionEntry<'talks'>;
  variant?: 'featured' | 'row';
  plate?: number; // featured only: numbered plate caption
}
const { talk, variant = 'row', plate } = Astro.props;
const { title, event, format, date, description, image, links } = talk.data;

const actions = [
  links.video && { href: links.video, label: 'watch recording ↗', external: true },
  links.event && { href: links.event, label: 'event page ↗', external: true },
  links.slides && { href: links.slides, label: 'download slides', external: false },
].filter(Boolean) as { href: string; label: string; external: boolean }[];

const caption = `${plate ? `plate ${plate} — ` : ''}${event.toLowerCase()}, ${monthYearShort(date)}`;
---

{
  variant === 'featured' ? (
    <article class="flex flex-col">
      {image && (
        <div class="plate">
          <i aria-hidden="true" /><i aria-hidden="true" /><i aria-hidden="true" /><i aria-hidden="true" />
          <Image
            src={image}
            alt={`Title slide: ${title}`}
            width={760}
            class="aspect-[16/9] w-full border border-edge object-cover"
          />
        </div>
      )}
      <p class="meta mt-2.5 px-3.5 text-dim">{caption}</p>
      <h3 class="mt-2.5 px-3.5 text-lg font-semibold leading-snug tracking-tight">{title}</h3>
      <p class="mt-2 px-3.5 text-sm leading-relaxed text-dim">{description}</p>
      {actions.length > 0 && (
        <p class="mt-auto px-3.5 pt-4">
          {actions.map((a) => (
            <a
              href={a.href}
              target={a.external ? '_blank' : undefined}
              rel={a.external ? 'noopener noreferrer' : undefined}
              class="meta lowercase mr-4 text-accent hover:underline"
            >
              {a.label}
            </a>
          ))}
        </p>
      )}
    </article>
  ) : (
    <article class="border-b border-edge py-5">
      <div class="grid items-start gap-x-6 gap-y-3 sm:grid-cols-[7.25rem_minmax(0,1fr)] lg:grid-cols-[7.25rem_minmax(0,1fr)_10rem]">
        <div class="meta flex gap-x-4 text-dim sm:flex-col sm:gap-y-1.5">
          <span>{isoDate(date)}</span>
          <span class="lowercase">{format}</span>
        </div>
        <div>
          <p class="meta lowercase text-dim">{event}</p>
          <h3 class="mt-1.5 text-lg font-semibold leading-snug tracking-tight">{title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-dim">{description}</p>
          {actions.length > 0 && (
            <p class="mt-3">
              {actions.map((a) => (
                <a
                  href={a.href}
                  target={a.external ? '_blank' : undefined}
                  rel={a.external ? 'noopener noreferrer' : undefined}
                  class="meta lowercase mr-4 text-accent hover:underline"
                >
                  {a.label}
                </a>
              ))}
            </p>
          )}
        </div>
        {image && (
          <Image
            src={image}
            alt={`Title slide: ${title}`}
            width={400}
            class="hidden w-full border border-edge object-cover lg:block"
          />
        )}
      </div>
    </article>
  )
}
