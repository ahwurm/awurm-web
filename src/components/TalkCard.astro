---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { isoDate } from '../lib/dates';

interface Props {
  talk: CollectionEntry<'talks'>;
}
const { talk } = Astro.props;
const { title, event, format, date, description, links, vendors } = talk.data;
const decideLabel = vendors[0] ?? event; // race trace label for "decide for me"

const actions = [
  links.video && { href: links.video, label: 'Watch recording ↗', external: true },
  links.event && { href: links.event, label: 'Event page ↗', external: true },
  links.slides && { href: links.slides, label: 'Download slides', external: false, icon: 'download' },
].filter(Boolean) as { href: string; label: string; external: boolean; icon?: string }[];

// Participant vendor logos (build-time assets, same set as the research cards).
const vendorIcons = import.meta.glob<{ default: ImageMetadata }>('../assets/vendors/*.png', { eager: true });
const icons = vendors
  .map((v) => ({ slug: v, img: vendorIcons[`../assets/vendors/${v}.png`]?.default }))
  .filter((x) => x.img);
---

<article class="rounded-[3px] border border-edge bg-surface" data-label={decideLabel}>
  <div class="flex h-full flex-col p-5">
    <div class="meta flex items-center justify-between gap-3 text-dim">
      <span>{isoDate(date)}</span>
      <span class="uppercase">{format}</span>
    </div>
    <div class="mt-3 flex items-center gap-2.5">
      {icons.map(({ slug, img }) => (
        <Image src={img!} alt={`${slug} logo`} width={40} height={40} class="h-5 w-5 rounded-[2px]" />
      ))}
      <p class="kicker text-dim">{event}</p>
    </div>
    <h3 class="font-display mt-2 text-[1.2rem] font-semibold leading-[1.25] tracking-tight text-accent">{title}</h3>
    <p class="mt-2 text-[0.9375rem] leading-relaxed text-dim">{description}</p>
    {actions.length > 0 && (
      <p class="mt-auto flex flex-wrap gap-5 pt-4">
        {actions.map((a) => (
          <a
            href={a.href}
            target={a.external ? '_blank' : undefined}
            rel={a.external ? 'noopener noreferrer' : undefined}
            class="link-rule inline-flex items-center gap-1.5 text-[0.875rem] font-medium"
          >
            {a.icon && <Icon name={a.icon} class="h-3.5 w-3.5" />}
            {a.label}
          </a>
        ))}
      </p>
    )}
  </div>
</article>
