---
// Project title rendered as the product's own brand lockup, where one exists.
// Both marks are ported from the products' own components and filled with
// `currentColor`, so they inherit the heading's accent — the page keeps ONE green
// instead of importing three brand greens. Projects without a mark fall through
// to plain text, which is the point: a product shows its wordmark, a paper doesn't.
//
// fantasytoolbench — the depth-chart F and T glyphs ARE the capitals of the two
// words (ported from site-app/src/components/Lockup.tsx: bars span baseline to
// ascender at 0.94em, bottom edge on the baseline via items-baseline, "a" tucked
// tight at 0.07em). This is why the wordmark is lowercase by design.
// localharness — the CLI's own startup banner, exactly as `localharness start`
// prints it (box-drawing ASCII, copied from localharness.dev's hero, which extracts
// it mechanically from a real capture). The sloth logomark is NOT used: Alex removed
// it 2026-06-09 ("completely worthless").
interface Props {
  name: string;
  brand?: 'fantasytoolbench' | 'localharness';
}
const { name, brand } = Astro.props;
import bannerRaw from '../data/localharness-banner.txt?raw';
const rows = bannerRaw.replace(/\n$/, '').split('\n');
const banner = [...rows.slice(0, 6), '', ...rows.slice(6)].join('\n');
---

{
  brand === 'fantasytoolbench' ? (
    <span class="inline-flex items-baseline" aria-label={name}>
      <svg viewBox="10 10 80 80" class="h-[0.94em] w-[0.94em] shrink-0 self-baseline" aria-hidden="true">
        <rect x="10" y="10" width="80" height="19.2" rx="5.8" fill="currentColor" />
        <rect x="10" y="40.4" width="49.6" height="19.2" rx="5.8" fill="currentColor" />
        <rect x="10" y="70.8" width="30.4" height="19.2" rx="5.8" fill="currentColor" />
      </svg>
      <span aria-hidden="true" class="ml-[0.07em]">antasy</span>
      <svg
        viewBox="10 10 80 80"
        class="ml-[0.05em] h-[0.94em] w-[0.94em] shrink-0 self-baseline"
        aria-hidden="true"
      >
        <rect x="10" y="10" width="80" height="19.2" rx="5.8" fill="currentColor" />
        <rect x="40.4" y="40.4" width="19.2" height="19.2" rx="5.8" fill="currentColor" />
        <rect x="40.4" y="70.8" width="19.2" height="19.2" rx="5.8" fill="currentColor" />
      </svg>
      <span aria-hidden="true" class="ml-[0.07em]">oolbench</span>
    </span>
    ) : brand === 'localharness' ? (
    <pre
      class="overflow-hidden whitespace-pre font-mono text-[length:clamp(0.3rem,0.95vw,0.44rem)] leading-none"
      aria-label={name}
    >{banner}</pre>
  ) : (
    name
  )
}
