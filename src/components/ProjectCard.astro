---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { name, description, technologies, status, url, githubUrl, paperUrl } = project.data;

const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const decideLabel = slug.split('-').slice(0, 2).join('-'); // short race trace label
---

<article class="rounded-[3px] border border-edge bg-surface" data-label={decideLabel}>
  <div class="flex h-full flex-col p-5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-display text-[1.25rem] font-semibold leading-snug tracking-tight text-accent">{name}</h3>
      <span class="kicker shrink-0 text-dim">{status}</span>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-dim">{description}</p>
    <p class="meta lowercase mt-3 text-dim" aria-label="Technologies">{technologies.join(' · ')}</p>
    <p class="mt-auto flex flex-wrap gap-4 pt-4">
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class="link-rule text-[0.875rem] font-medium">
          {url.includes('streamlit') ? 'Streamlit app ↗' : 'View project ↗'}
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="link-rule text-[0.875rem] font-medium">
          GitHub ↗
        </a>
      )}
      {paperUrl && (
        <a
          href={paperUrl}
          download="wurm-2021-timing-anticipatory-decisions.pdf"
          class="link-rule text-[0.875rem] font-medium"
        >
          Download paper
        </a>
      )}
    </p>
  </div>
</article>
