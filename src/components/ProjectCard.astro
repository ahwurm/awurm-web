---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { name, description, technologies, status, url, githubUrl, paperUrl, screenshots } = project.data;
---

<article class="border-b border-edge py-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-xl font-semibold leading-snug tracking-tight">{name}</h3>
    <span class="meta lowercase shrink-0 text-dim">{status}</span>
  </div>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-dim">{description}</p>
  <p class="meta lowercase mt-3 text-dim" aria-label="Technologies">
    {technologies.join(' · ')}
  </p>
  {
    screenshots.length > 0 && (
      <details class="mt-3.5">
        <summary class="meta lowercase cursor-pointer text-accent hover:underline">
          view screenshot{screenshots.length > 1 ? 's' : ''}
        </summary>
        <div class="mt-3 max-w-3xl space-y-3">
          {screenshots.map((s) => (
            <Image src={s} alt={`${name} screenshot`} width={1000} class="w-full border border-edge" />
          ))}
        </div>
      </details>
    )
  }
  <p class="mt-3.5 flex flex-wrap gap-4">
    {url && (
      <a href={url} target="_blank" rel="noopener noreferrer" class="meta lowercase text-accent hover:underline">
        {url.includes('streamlit') ? 'streamlit app ↗' : 'view project ↗'}
      </a>
    )}
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="meta lowercase text-accent hover:underline">
        github ↗
      </a>
    )}
    {paperUrl && (
      <a
        href={paperUrl}
        download="wurm-2021-timing-anticipatory-decisions.pdf"
        class="meta lowercase text-accent hover:underline"
      >
        download paper
      </a>
    )}
  </p>
</article>
