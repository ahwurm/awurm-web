---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found — Alexander H. Wurm" description="Page not found." noindex>
  <section class="container-site flex flex-col items-center py-28 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-md text-dim">
      The page you're looking for doesn't exist. It might have been moved, deleted, or you entered the wrong URL.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <Button href="/">Go to homepage</Button>
      <Button href="/research/" variant="outline">Browse research</Button>
    </div>
  </section>
</Base>
