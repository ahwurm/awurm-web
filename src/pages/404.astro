---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';

// Static failed trial (scripts/hero-fig.mjs): three traces, no first passage.
const svgAlt =
  'Drift-diffusion trial with three evidence traces that wander but never reach the decision boundary a = 1.2.';
