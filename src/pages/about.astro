---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialLinks from '../components/SocialLinks.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { profile } from '../data/profile';
import { profilePageJsonLd } from '../lib/jsonld';
import spacexPhoto from '../assets/photos/spacex-photo.jpg';
import cdmLogo from '../assets/photos/cdm-lab-logo.png';

const publications = (await getCollection('publications')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year
);

const description =
  'About Alexander H. Wurm — Principal Analyst at Nucleus Research with a background in cognitive science and decision modeling at the University of Florida.';
---

<Base title="About — Alexander H. Wurm" description={description} ogImage="/og/about.png">
  <script type="application/ld+json" set:html={JSON.stringify(profilePageJsonLd())} slot="head" is:inline />

  <!-- Bio -->
  <section class="container-site py-12 sm:py-16">
    <h1 class="display-tight text-[clamp(2.8rem,6vw,4.4rem)] font-semibold"><span class="text-accent">~/</span>about</h1>
    <div class="acc-rule mt-5" aria-hidden="true"></div>
    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[3fr_2fr]">
      <div class="space-y-5 text-[17px] leading-relaxed">
        {profile.bio.map((para) => <p>{para}</p>)}
        <p class="text-sm text-dim">
          Quoted in:
          {
            profile.press.map((p, i) => (
              <>
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="font-medium text-accent hover:underline">
                  {p.outlet}
                </a>
                {i < profile.press.length - 1 && <span> · </span>}
              </>
            ))
          }
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <Button href={profile.resumeUrl} download="Alexander_Wurm_Resume.pdf">Download resume</Button>
          <Button href="#contact" variant="outline">Get in touch</Button>
        </div>
      </div>
      <div class="flex gap-4 lg:flex-col">
        <Image
          src={spacexPhoto}
          alt="SpaceX Visit"
          width={640}
          class="w-1/2 rounded-[3px] border border-edge object-cover lg:w-full"
        />
        <Image
          src={cdmLogo}
          alt="Cognition & Decision Modeling Laboratory"
          width={400}
          class="w-1/2 self-start rounded-[3px] border border-edge bg-white object-contain p-3 lg:w-56"
        />
      </div>
    </div>
  </section>

  <!-- Experience -->
  <Section banded title="Experience">
    <div class="mt-4">
      {
        profile.experience.map((job) => (
          <div class="border-b border-edge py-6">
            <div class="grid gap-x-6 gap-y-1.5 sm:grid-cols-[10.5rem_minmax(0,1fr)]">
              <p class="meta pt-1.5 text-dim">{job.period}</p>
              <div>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <h3 class="text-xl font-semibold tracking-tight">{job.org}</h3>
                  <p class="meta lowercase text-dim">{job.location}</p>
                </div>
                <p class="mt-1 text-sm font-medium text-accent">{job.role}</p>
                <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-dim">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Education + skills -->
  <Section title="Education">
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        profile.education.map((ed) => (
          <Card>
            <h3 class="text-lg font-semibold tracking-tight">{ed.degree}</h3>
            <p class="mt-1.5 text-sm text-dim">{ed.school}</p>
            <p class="meta mt-1 text-dim">{ed.period}</p>
            <p class="mt-1 text-sm font-medium text-accent">{ed.honors}</p>
          </Card>
        ))
      }
    </div>
    <h3 class="mt-12 text-xl font-semibold tracking-tight">{profile.skillsHeading}</h3>
    <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-dim">
      {profile.skills.map((s) => <li>{s}</li>)}
    </ul>
  </Section>

  <!-- Publications -->
  <Section banded title="Publications">
    <div class="mt-8 space-y-5">
      {publications.map((p) => <PublicationItem publication={p} />)}
    </div>
  </Section>

  <!-- Contact -->
  <Section id="contact" title="Contact" sub={profile.contactBlurb}>
    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <ContactForm />
      <div>
        <h3 class="text-lg font-semibold tracking-tight">Connect online</h3>
        <p class="mt-2 text-sm text-dim">
          Email <a href={`mailto:${profile.email}`} class="font-medium text-accent hover:underline">{profile.email}</a>
          or find me on LinkedIn and GitHub.
        </p>
        <div class="mt-4">
          <SocialLinks />
        </div>
      </div>
    </div>
  </Section>
</Base>
