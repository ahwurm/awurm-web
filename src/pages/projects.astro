---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectSection from '../components/ProjectSection.astro';
import sctDashboard from '../assets/projects/smart-capital-tracker-dashboard.png';
import accumulatorModel from '../assets/figures/accumulator-model.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const description =
  'Projects by Alexander H. Wurm — LocalHarness (open-source local-AI tooling), Smart Capital Tracker (13F analysis), and a Wald accumulator model of anticipatory decisions.';

// Presentation layer for the stacked sections: normalized status, 2-3 curated
// descriptors, and the section visual. Statuses/descriptors are derived from
// each project's own frontmatter; the four visuals are real captured assets
// (LocalHarness demo recording, live dashboard, paper figure).
const D = '/projects/localharness-demo';
const meta: Record<string, { status: string; tags: string[]; visual: any }> = {
  LocalHarness: {
    status: 'open source',
    tags: ['local ai', 'agents', 'python'],
    visual: {
      kind: 'video',
      label: 'demo.mp4',
      webm: `${D}.webm`,
      mp4: `${D}.mp4`,
      poster: `${D}-poster.jpg`,
      alt: 'LocalHarness REPL mid-session — auto-detecting a local model, then chaining web_search and web_fetch to research a question and return a result table',
    },
  },
  'Smart Capital Tracker': {
    status: 'open source',
    tags: ['finance', 'streamlit', 'python'],
    visual: {
      kind: 'image',
      label: 'dashboard.png',
      src: sctDashboard,
      fit: 'contain',
      matte: '#ffffff',
      alt: 'Smart Capital Tracker dashboard — a Top 100 holdings scatter and a Top 20 by portfolio-percentage bar chart across 13F filers',
    },
  },
  'Wald Accumulator Model for Simple Anticipatory Decisions': {
    status: 'research',
    tags: ['decision science', 'bayesian', 'R'],
    visual: {
      kind: 'image',
      label: 'accumulator-model.png',
      src: accumulatorModel,
      fit: 'contain',
      matte: '#ffffff',
      alt: 'Diagram of the Wald accumulator model: evidence accumulates toward a decision threshold, generating the response-time distribution',
    },
  },
};

const linksFor = (d: (typeof projects)[number]['data']) =>
  [
    d.url && { label: d.url.includes('streamlit') ? 'Streamlit app ↗' : 'View project ↗', href: d.url },
    d.githubUrl && { label: 'GitHub ↗', href: d.githubUrl },
    d.paperUrl && {
      label: 'Download paper',
      href: d.paperUrl,
      download: 'wurm-2021-timing-anticipatory-decisions.pdf',
      icon: 'download',
    },
  ].filter(Boolean) as { label: string; href: string; download?: string; icon?: string }[];
---

<Base title="Projects — Alexander H. Wurm" description={description} ogImage="/og/projects.png">
  <section class="container-site pt-10 pb-12 sm:pt-12 sm:pb-16">
    <h1 class="display-tight flex items-center gap-3 text-[clamp(1.9rem,4vw,2.7rem)] font-semibold">
      <Icon name="box" class="h-[0.8em] w-[0.8em] text-accent" />projects
    </h1>
    <div class="acc-rule mt-5" aria-hidden="true"></div>
    <p class="meta lowercase mt-6 text-dim">n = {projects.length}</p>

    <div class="mt-4">
      {
        projects.map((project, i) => {
          const m = meta[project.data.name];
          if (!m) throw new Error(`projects.astro: no section meta for "${project.data.name}"`);
          const links = linksFor(project.data);
          return (
            <ProjectSection
              index={i + 1}
              name={project.data.name}
              description={project.data.description}
              status={m.status}
              tags={m.tags}
              links={links}
              titleHref={links[0]?.href}
              visual={m.visual}
            />
          );
        })
      }
    </div>
  </section>
</Base>
