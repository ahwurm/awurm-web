---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectSection from '../components/ProjectSection.astro';
import sctDashboard from '../assets/projects/smart-capital-tracker-dashboard.png';
import accumulatorModel from '../assets/figures/accumulator-model.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const description =
  'Projects by Alexander H. Wurm — LocalHarness (open-source local-AI tooling), fantasytoolbench (backend-free fantasy football draft tools), Smart Capital Tracker (13F analysis), and a Wald accumulator model of anticipatory decisions.';

// Presentation layer for the stacked sections: the optional brand lockup and the
// section visual. The four visuals are real captured assets (LocalHarness demo
// recording, fantasytoolbench draft-room capture, live dashboard, paper figure).
const D = '/projects/localharness-demo';
const F = '/projects/fantasytoolbench-draft';
const meta: Record<string, { brand?: 'fantasytoolbench' | 'localharness'; visual: any }> = {
  LocalHarness: {
    brand: 'localharness',
    visual: {
      kind: 'video',
      label: 'demo.mp4',
      webm: `${D}.webm`,
      mp4: `${D}.mp4`,
      poster: `${D}-poster.jpg`,
      alt: 'LocalHarness REPL mid-session — auto-detecting a local model, then chaining web_search and web_fetch to research a question and return a result table',
    },
  },
  fantasytoolbench: {
    brand: 'fantasytoolbench',
    visual: {
      kind: 'video',
      label: 'draft-room.mp4',
      webm: `${F}.webm`,
      mp4: `${F}.mp4`,
      poster: `${F}-poster.jpg`,
      alt: 'The fantasytoolbench draft room mid-draft — picks landing across twelve teams in real time, the roster panel filling on the left, and live survival-probability percentages on the right rail',
    },
  },
  'Smart Capital Tracker': {
    visual: {
      kind: 'image',
      label: 'dashboard.png',
      src: sctDashboard,
      fit: 'contain',
      matte: '#ffffff',
      alt: 'Smart Capital Tracker dashboard — a Top 100 holdings scatter and a Top 20 by portfolio-percentage bar chart across 13F filers',
    },
  },
  'Wald Accumulator Model for Simple Anticipatory Decisions': {
    visual: {
      kind: 'image',
      label: 'accumulator-model.png',
      src: accumulatorModel,
      fit: 'contain',
      matte: '#ffffff',
      alt: 'Diagram of the Wald accumulator model: evidence accumulates toward a decision threshold, generating the response-time distribution',
    },
  },
};

const linksFor = (d: (typeof projects)[number]['data']) =>
  [
    d.url && { label: d.url.includes('streamlit') ? 'Streamlit app ↗' : 'View project ↗', href: d.url },
    d.githubUrl && { label: 'GitHub ↗', href: d.githubUrl },
    d.extensionUrl && { label: 'Chrome extension ↗', href: d.extensionUrl },
    d.paperUrl && {
      label: 'Download paper',
      href: d.paperUrl,
      download: 'wurm-2021-timing-anticipatory-decisions.pdf',
      icon: 'download',
    },
  ].filter(Boolean) as { label: string; href: string; download?: string; icon?: string }[];
---

<Base
  title="Projects — Alexander H. Wurm"
  description={description}
  ogImage="/og/projects.png"
  pageTitle="projects"
  pageIcon="box"
  decide
>
  <section class="container-site pt-8 pb-12 sm:pt-10 sm:pb-16">
    <div id="model-race" class="plate mb-2 mt-4" hidden>
      <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
      <canvas id="model-race-canvas" class="h-36 w-full"></canvas>
    </div>
    <p id="model-race-live" class="sr-only" role="status" aria-live="polite"></p>

    <div class="mt-4">
      {
        projects.map((project) => {
          const m = meta[project.data.name];
          if (!m) throw new Error(`projects.astro: no section meta for "${project.data.name}"`);
          const links = linksFor(project.data);
          return (
            <ProjectSection
              slug={project.id.replace(/\.md$/, '')}
              name={project.data.name}
              description={project.data.description}
              links={links}
              titleHref={links[0]?.href}
              brand={m.brand}
              visual={m.visual}
            />
          );
        })
      }
    </div>
  </section>

  <script>
    import { wireDecide } from '../lib/decide';

    wireDecide({
      items: Array.from(document.querySelectorAll<HTMLElement>('[data-project]')),
      button: document.getElementById('page-decide') as HTMLButtonElement,
      raceWrap: document.getElementById('model-race')!,
      canvas: document.getElementById('model-race-canvas') as HTMLCanvasElement,
      live: document.getElementById('model-race-live')!,
    });
  </script>
</Base>
