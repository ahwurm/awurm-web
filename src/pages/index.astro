---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import IndustryItem from '../components/IndustryItem.astro';
import TalkCard from '../components/TalkCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import Frame from '../components/Frame.astro';
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import { site } from '../data/site';
import { ledgerIndices } from '../lib/ledger';
import responseFig from '../assets/figures/response-distributions.png';
import spacexPhoto from '../assets/photos/spacex-photo.jpg';

const publications = await getCollection('publications');
const highlight = publications.find((p) => p.data.featured) ?? publications[0];

const industryAll = (await getCollection('industryResearch')).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate)
);
const indices = ledgerIndices(industryAll);
const industry = industryAll.slice(0, 3);

const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={site.title} description={site.description} ogImage="/og/home.png">
  <!-- Hero: name + a real terminal -->
  <section class="container-site grid items-center gap-x-12 gap-y-10 pb-16 pt-12 sm:pt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:pb-24">
    <div>
      <p class="kicker text-accent">// ai · data · decision science</p>
      <h1 class="display-tight mt-5 font-semibold">
        <span class="block text-[clamp(2.9rem,7vw,5.3rem)]">Alexander</span>
        <span class="block text-[clamp(2.9rem,7vw,5.3rem)]">Wurm<span class="text-accent">_</span></span>
      </h1>
      <p class="mt-6 max-w-[46ch] text-[1.05rem] leading-relaxed text-dim">
        {profile.oneLiner}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/projects/">view projects</Button>
        <Button href={profile.socials.github} variant="outline" external>github ↗</Button>
      </div>
      <div class="mt-7">
        <SocialLinks />
      </div>
    </div>
    <Terminal />
  </section>

  <!-- Projects -->
  <Section num="01" title="projects" sub="Selected software and research projects.">
    <div class="mt-8">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <!-- Research -->
  <Section
    num="02"
    title="research"
    sub="Peer-reviewed work in decision science, and ongoing industry research at Nucleus."
  >
    <div class="mt-10 grid items-start gap-x-14 gap-y-10 lg:grid-cols-[2fr_3fr]">
      <article>
        <p class="kicker text-dim">academic_highlight · {highlight.data.year}</p>
        <h3 class="mt-4 font-sans text-[1.25rem] font-semibold leading-snug tracking-tight">
          <a
            href={highlight.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-150 hover:text-accent">{highlight.data.title}</a
          >
        </h3>
        <p class="mt-3 text-sm text-dim">{highlight.data.authors}</p>
        <p class="meta mt-2 text-dim">{highlight.data.venue}</p>
        <Frame label="~/figures/response-distributions.png" class="mt-6">
          <Image
            src={responseFig}
            alt="Response time distributions from the anticipatory timing model"
            width={680}
            class="w-full bg-white"
          />
        </Frame>
        <p class="mt-6">
          <a href="/research/" class="link-rule meta">cd /research →</a>
        </p>
      </article>
      <div>
        <div class="space-y-4">
          {industry.map((entry) => <IndustryItem entry={entry.data} index={indices.get(entry.id)!} />)}
        </div>
        <p class="mt-7">
          <a href="/research/?tab=industry" class="link-rule meta">
            cd /research --tab=industry → {industryAll.length} notes
          </a>
        </p>
      </div>
    </div>
  </Section>

  <!-- Speaking -->
  <Section num="03" title="speaking" sub={profile.speakingIntro}>
    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      {talks.map((talk) => <TalkCard talk={talk} variant="featured" />)}
    </div>
    <p class="mt-9">
      <a href="/speaking/" class="link-rule meta">cd /speaking →</a>
    </p>
  </Section>

  <!-- About teaser -->
  <Section num="04" title="about" sub="The person behind the prompt.">
    <div class="mt-10 grid items-center gap-x-14 gap-y-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)]">
      <div>
        <p class="max-w-[52ch] text-[1.02rem] leading-relaxed text-dim">{profile.bio[0]}</p>
        <p class="mt-7">
          <a href="/about/" class="link-rule meta">cd /about →</a>
        </p>
      </div>
      <Frame label="~/photos/starbase.jpg">
        <Image
          src={spacexPhoto}
          alt="Alexander Wurm at SpaceX Starbase"
          width={880}
          class="aspect-[4/3] w-full object-cover"
        />
      </Frame>
    </div>
  </Section>
</Base>
