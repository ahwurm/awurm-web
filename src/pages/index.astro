---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import IndustryItem from '../components/IndustryItem.astro';
import TalkCard from '../components/TalkCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { site } from '../data/site';
import { ledgerIndices } from '../lib/ledger';

const publications = await getCollection('publications');
const highlight = publications.find((p) => p.data.featured) ?? publications[0];

const industryAll = (await getCollection('industryResearch')).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate)
);
const indices = ledgerIndices(industryAll);
const industry = industryAll.slice(0, 3);

const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.pop();
---

<Base title={site.title} description={site.description} ogImage="/og/home.png">
  <!-- Hero: pure typography, full editorial scale -->
  <section class="container-site pb-20 pt-14 sm:pb-28 sm:pt-24">
    <p class="kicker text-accent">AI · Data · Decision Science</p>
    <h1 class="display-tight mt-6 font-semibold" aria-label={profile.name}>
      <span class="block text-[clamp(3.2rem,9.5vw,7.6rem)]">{firstName}</span>
      <span class="block text-[clamp(3.2rem,9.5vw,7.6rem)]">{lastName}<span class="text-accent">.</span></span>
    </h1>
    <div class="mt-12 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <p class="max-w-[42ch] font-display text-[clamp(1.3rem,2.1vw,1.6rem)] font-medium leading-[1.4]">
        {profile.oneLiner}
      </p>
      <div class="flex shrink-0 flex-col items-start gap-6">
        <div class="flex flex-wrap items-center gap-3">
          <Button href="/projects/">View projects</Button>
          <Button href={profile.socials.github} variant="outline" external>GitHub ↗</Button>
        </div>
        <SocialLinks />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <Section num="01" title="Projects" sub="Selected software and research projects.">
    <div class="mt-8">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <!-- Research -->
  <Section
    num="02"
    title="Research"
    sub="Peer-reviewed work in decision science, and ongoing industry research at Nucleus."
  >
    <div class="mt-12 grid items-start gap-x-14 gap-y-10 lg:grid-cols-[2fr_3fr]">
      <article>
        <p class="kicker text-dim">Academic highlight · {highlight.data.year}</p>
        <h3 class="display-tight mt-4 text-[1.6rem] font-semibold leading-[1.15]">
          <a
            href={highlight.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-150 hover:text-accent">{highlight.data.title}</a
          >
        </h3>
        <p class="mt-3 text-sm text-dim">{highlight.data.authors}</p>
        <p class="mt-1.5 text-sm italic text-dim">{highlight.data.venue}</p>
        <p class="mt-6">
          <a href="/research/" class="link-rule text-[0.95rem] font-medium">All academic research</a>
        </p>
      </article>
      <div>
        <div class="-mt-5">
          {industry.map((entry) => <IndustryItem entry={entry.data} index={indices.get(entry.id)!} />)}
        </div>
        <p class="mt-7">
          <a href="/research/?tab=industry" class="link-rule text-[0.95rem] font-medium">
            Browse the industry research archive — {industryAll.length} notes
          </a>
        </p>
      </div>
    </div>
  </Section>

  <!-- Speaking -->
  <Section num="03" title="Speaking" sub={profile.speakingIntro}>
    <div class="mt-12 grid gap-10 sm:grid-cols-2">
      {talks.map((talk) => <TalkCard talk={talk} variant="featured" />)}
    </div>
    <p class="mt-10">
      <a href="/speaking/" class="link-rule text-[0.95rem] font-medium">All speaking engagements</a>
    </p>
  </Section>
</Base>
