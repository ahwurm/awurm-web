---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import IndustryItem from '../components/IndustryItem.astro';
import HeroAccumulator from '../components/HeroAccumulator.astro';
import TalkCard from '../components/TalkCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { site } from '../data/site';
import headshot from '../assets/photos/headshot.jpg';

const publications = await getCollection('publications');
const highlight = publications.find((p) => p.data.featured) ?? publications[0];

const industry = (await getCollection('industryResearch'))
  .sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate))
  .slice(0, 3);

const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={site.title} description={site.description} ogImage="/og/home.png">
  <!-- Hero: the methods figure runs the trial; the copy is its output -->
  <section
    class="container-site grid items-center gap-x-12 gap-y-10 pb-16 pt-10 sm:pt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,500px)] lg:pb-24 lg:pt-16"
  >
    <div id="hero-copy" class="order-2 lg:order-1">
      <p class="stamp meta uppercase text-dim" style="--st: 0">{profile.role}</p>
      <h1
        class="stamp mt-3 text-balance text-[clamp(2.6rem,6.5vw,5.5rem)] font-semibold leading-[1.04] tracking-[-0.015em]"
        style="--st: 1"
      >
        {profile.name}
      </h1>
      <p class="stamp meta mt-4 min-h-[1.25rem] tracking-[0.02em] text-dim" style="--st: 2" id="hero-readout">
        <span class="sr-only" id="hero-readout-sr">decision: alexander_h_wurm · rt = 487 ms · trials = 1</span>
        <span aria-hidden="true" id="hero-readout-vis">decision: alexander_h_wurm · rt = 487 ms · trials = 1</span>
      </p>
      <p class="stamp mt-6 max-w-xl text-pretty text-lg text-dim" style="--st: 3">{profile.oneLiner}</p>
      <div class="stamp mt-8 flex flex-wrap items-center gap-3" style="--st: 4">
        <Button href="/research/">Explore research</Button>
        <Button href="/projects/" variant="outline">View projects</Button>
      </div>
      <div class="stamp mt-9 flex items-center gap-4" style="--st: 5">
        <Image
          src={headshot}
          alt={profile.name}
          width={160}
          class="h-13 w-13 rounded-[3px] border border-edge object-cover"
          loading="eager"
        />
        <SocialLinks />
      </div>
    </div>
    <!-- Pre-paint: hide the copy only when JS will actually run the trial -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.getElementById('hero-copy').classList.add('stamp-wait');
    </script>
    <HeroAccumulator class="order-1 w-full lg:order-2" />
  </section>

  <!-- Research band -->
  <Section banded title="Research" sub="Peer-reviewed work in decision science, and ongoing industry research at Nucleus.">
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <article class="flex flex-col rounded-xl border border-edge bg-surface p-6">
        <p class="font-mono text-xs text-dim">Academic highlight · {highlight.data.year}</p>
        <h3 class="mt-2.5 text-xl font-semibold leading-snug tracking-tight">
          <a
            href={highlight.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-150 hover:text-accent">{highlight.data.title}</a
          >
        </h3>
        <p class="mt-2 text-sm text-dim">{highlight.data.authors}</p>
        <p class="mt-1 text-sm text-dim">{highlight.data.venue}</p>
        <p class="mt-auto pt-5">
          <a href="/research/" class="text-sm font-medium text-accent hover:underline">All academic research →</a>
        </p>
      </article>
      <div class="flex flex-col gap-4">
        {industry.map((entry) => <IndustryItem entry={entry.data} />)}
        <p>
          <a href="/research/?tab=industry" class="text-sm font-medium text-accent hover:underline">
            Browse the industry research archive →
          </a>
        </p>
      </div>
    </div>
  </Section>

  <!-- Speaking band -->
  <Section title="Speaking" sub={profile.speakingIntro}>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {talks.map((talk) => <TalkCard talk={talk} variant="featured" />)}
    </div>
    <p class="mt-6">
      <a href="/speaking/" class="text-sm font-medium text-accent hover:underline">All speaking engagements →</a>
    </p>
  </Section>

  <!-- Projects band -->
  <Section banded title="Projects" sub="Selected software and research projects.">
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>
</Base>
