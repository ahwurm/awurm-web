---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PublicationItem from '../components/PublicationItem.astro';
import IndustryItem from '../components/IndustryItem.astro';
import { ledgerIndices } from '../lib/ledger';

const publications = (await getCollection('publications')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year
);

const industry = (await getCollection('industryResearch')).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate)
);
const indices = ledgerIndices(industry);

const count = (pred: (d: (typeof industry)[number]['data']) => boolean) =>
  industry.filter((e) => pred(e.data)).length;

const years = [...new Set(industry.map((e) => e.data.year))].sort((a, b) => b - a);
const types = [...new Set(industry.map((e) => e.data.type))].sort();

const description = `Academic publications in decision science and ${industry.length} industry research notes, ROI studies, and value matrices by Alexander H. Wurm, Principal Analyst at Nucleus Research.`;
---

<Base title="Research — Alexander H. Wurm" description={description} ogImage="/og/research.png">
  <section class="container-site rise-in py-12 sm:py-16">
    <h1 class="text-4xl font-semibold tracking-tight">Research</h1>

    <!-- Controls -->
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div role="tablist" aria-label="Research type" class="flex w-fit rounded-lg border border-edge bg-surface p-1">
        <a
          id="tab-academic"
          href="/research/"
          role="tab"
          aria-selected="true"
          aria-controls="panel-academic"
          class="rounded-md px-4 py-1.5 text-sm font-medium transition-colors aria-selected:bg-accent-fill aria-selected:text-accent-ink"
        >
          Academic
        </a>
        <a
          id="tab-industry"
          href="/research/?tab=industry"
          role="tab"
          aria-selected="false"
          aria-controls="panel-industry"
          class="rounded-md px-4 py-1.5 text-sm font-medium text-dim transition-colors hover:text-ink aria-selected:bg-accent-fill aria-selected:text-accent-ink"
        >
          Industry ({industry.length})
        </a>
      </div>

      <div id="industry-filters" class="flex gap-2" hidden>
        <label class="sr-only" for="filter-type">Filter by type</label>
        <select
          id="filter-type"
          class="rounded-lg border border-edge bg-surface px-3 py-2 text-sm font-medium"
        >
          <option value="">All types</option>
          {types.map((t) => <option value={t}>{t} ({count((d) => d.type === t)})</option>)}
        </select>
        <label class="sr-only" for="filter-year">Filter by year</label>
        <select
          id="filter-year"
          class="rounded-lg border border-edge bg-surface px-3 py-2 text-sm font-medium"
        >
          <option value="">All years</option>
          {years.map((y) => <option value={String(y)}>{y} ({count((d) => d.year === y)})</option>)}
        </select>
      </div>
    </div>

    <!-- Academic panel -->
    <div id="panel-academic" role="tabpanel" aria-labelledby="tab-academic" class="mt-8 space-y-5">
      {publications.map((p) => <PublicationItem publication={p} />)}
    </div>

    <!-- Industry panel (statically rendered for SEO; toggled client-side) -->
    <div id="panel-industry" role="tabpanel" aria-labelledby="tab-industry" class="mt-8" hidden>
      <div id="industry-list" class="grid gap-4 lg:grid-cols-2">
        {industry.map((entry) => <IndustryItem entry={entry.data} index={indices.get(entry.id)!} />)}
      </div>
      <p id="industry-empty" class="py-12 text-center text-dim" hidden>No research matches these filters.</p>
    </div>
  </section>

  <!-- No-JS: show both panels stacked (tabs degrade to page links). -->
  <noscript>
    <style>
      #panel-industry[hidden] {
        display: block;
      }
      #panel-industry::before {
        content: 'Industry research';
        display: block;
        font-size: 1.5rem;
        font-weight: 600;
        font-family: var(--font-display);
        margin-bottom: 1rem;
      }
    </style>
  </noscript>

  <script>
    // Research filters: URL contract is ?tab=industry (+ optional &year= & type=).
    const tabs = { academic: document.getElementById('tab-academic')!, industry: document.getElementById('tab-industry')! };
    const panels = { academic: document.getElementById('panel-academic')!, industry: document.getElementById('panel-industry')! };
    const filters = document.getElementById('industry-filters')!;
    const typeSel = document.getElementById('filter-type') as HTMLSelectElement;
    const yearSel = document.getElementById('filter-year') as HTMLSelectElement;
    const items = [...document.querySelectorAll<HTMLElement>('#industry-list > article')];
    const empty = document.getElementById('industry-empty')!;

    const applyFilters = () => {
      let visible = 0;
      for (const item of items) {
        const show =
          (!yearSel.value || item.dataset.year === yearSel.value) &&
          (!typeSel.value || item.dataset.type === typeSel.value);
        item.hidden = !show;
        if (show) visible++;
      }
      empty.hidden = visible > 0;
    };

    const setTab = (tab: 'academic' | 'industry') => {
      for (const t of ['academic', 'industry'] as const) {
        tabs[t].setAttribute('aria-selected', String(t === tab));
        panels[t].hidden = t !== tab;
      }
      filters.hidden = tab !== 'industry';
    };

    const applyFromUrl = () => {
      const params = new URLSearchParams(location.search);
      const tab = params.get('tab') === 'industry' ? 'industry' : 'academic';
      typeSel.value = params.get('type') ?? '';
      yearSel.value = params.get('year') ?? '';
      if ([...typeSel.options].every((o) => o.value !== typeSel.value)) typeSel.value = '';
      if ([...yearSel.options].every((o) => o.value !== yearSel.value)) yearSel.value = '';
      setTab(tab);
      applyFilters();
    };

    const syncUrl = () => {
      const params = new URLSearchParams();
      if (!panels.industry.hidden) {
        params.set('tab', 'industry');
        if (typeSel.value) params.set('type', typeSel.value);
        if (yearSel.value) params.set('year', yearSel.value);
      }
      const qs = params.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    };

    tabs.academic.addEventListener('click', (e) => {
      e.preventDefault();
      setTab('academic');
      syncUrl();
    });
    tabs.industry.addEventListener('click', (e) => {
      e.preventDefault();
      setTab('industry');
      syncUrl();
    });
    typeSel.addEventListener('change', () => {
      applyFilters();
      syncUrl();
    });
    yearSel.addEventListener('change', () => {
      applyFilters();
      syncUrl();
    });
    window.addEventListener('popstate', applyFromUrl);
    applyFromUrl();
  </script>
</Base>
